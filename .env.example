# Runtime configuration for den-embed. Every variable is optional. The binary reads the process
# environment only (no .env loader): export these for `cargo run`; on the homelab they come from the
# den repo's deploy/. A number outside its range is clamped and a malformed one falls back to the
# default, each with a log line. The ranges are memory and latency bounds (CLAUDE.md has the figures).

# Listen port, on 0.0.0.0.
# PORT=8080

# Bearer token for GET /metrics (Prometheus text). Unset or empty ⇒ the route answers 404.
# METRICS_TOKEN=

# One stderr line per request: `<METHOD> <path> <status> <ms>ms`, never the query string (it carries
# the search text). Unset, empty or 0 is off; anything else is on.
# LOG_REQUESTS=1

# Directory holding model_int8.onnx and tokenizer.json (the image bakes them into /models).
# MODEL_DIR=/models
# Point at either file directly; default is inside MODEL_DIR.
# ONNX_PATH=/models/model_int8.onnx
# TOKENIZER_PATH=/models/tokenizer.json

# Unload the model after this many idle seconds; 0 keeps it loaded. 0–86400. The box sets 600.
# IDLE_UNLOAD_SECS=0

# Per-text character cut, before tokenizing. 500–100000.
# MAX_CHARS=8000
# Per-text token cap. 16–1024. Changing it changes the vector of anything longer.
# MAX_TOKENS=512
# Total tokens per request, batch included. 512–12288.
# MAX_REQUEST_TOKENS=8192
# Texts per batch; a 413 above it, not a micro-batch. 1–4096.
# MAX_BATCH=512
# Request body limit in bytes. 65536–16777216.
# MAX_BODY_BYTES=4194304

# Cached vectors (~4.2 KB each); 0 turns the cache off. 0–32768.
# CACHE_MAX_ENTRIES=8192
# ONNX Runtime intra-op threads; 0 uses all cores. 0–256.
# INTRA_THREADS=0
# Seconds a SIGTERM waits for in-flight requests. 1–9, below podman's default 10 s stop timeout.
# DRAIN_GRACE_SECS=8

# Tests only: a directory with the model files, for the one shutdown test that needs them.
# TEST_MODEL_DIR=
